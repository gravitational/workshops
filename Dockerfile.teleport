# Keep in step with Dockerfile.ci-runner (tbot) and the `version:` in
# github/repo/.github/workflows/deploy.yaml (the setup action checks it).
ARG TELEPORT_VERSION=19.0.1
FROM public.ecr.aws/gravitational/teleport-ent-distroless-debug:${TELEPORT_VERSION}
COPY teleport/teleport.yaml teleport/bootstrap.yaml /etc/teleport/
COPY teleport/passwd /etc/passwd
COPY teleport/profile /etc/profile
COPY teleport/login.defs /etc/login.defs
COPY teleport/setup.sh /setup.sh
COPY teleport/access-lists.yaml /access-lists.yaml
COPY teleport/gha-demo-resources.yaml /gha-demo-resources.yaml
