# syntax=docker/dockerfile:1
ARG GO_VERSION=1.27
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-bookworm AS build
WORKDIR /src
COPY simulator/go.mod simulator/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY simulator/ ./
ARG TARGETOS
ARG TARGETARCH
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags="-s -w" -o /out/simulator .

FROM gcr.io/distroless/static-debian12
COPY --from=build /out/simulator /usr/local/bin/simulator
ENV SIMULATOR_DATA_DIR=/data
EXPOSE 8080 8443 9443 443 10443
ENTRYPOINT ["/usr/local/bin/simulator"]
